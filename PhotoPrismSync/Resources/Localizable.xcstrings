    "Fetched from server: %lld (pages: %lld). Matching your criteria: %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetched from server: %lld (pages: %lld). Matching your criteria: %lld."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Van bediener gehaal: %1$lld (bladsye: %2$lld). Stem met jou kriteria ooreen: %3$lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الجلب من الخادم: %1$lld (الصفحات: %2$lld). المطابق لمعاييرك: %3$lld."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zerbitzaritik eskuratuta: %1$lld (orriak: %2$lld). Zure irizpideekin bat datozenak: %3$lld."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрымана з сервера: %1$lld (старонак: %2$lld). Адпавядае вашым крытэрыям: %3$lld."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Извлечени от сървъра: %1$lld (страници: %2$lld). Отговарят на критериите ви: %3$lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtinguts del servidor: %1$lld (pàgines: %2$lld). Coincideixen amb els teus criteris: %3$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从服务器获取：%1$lld（页数：%2$lld）。符合您的条件：%3$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已從伺服器擷取：%1$lld（頁數：%2$lld）。符合您的條件：%3$lld。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dohvaćeno s poslužitelja: %1$lld (stranica: %2$lld). Odgovara vašim kriterijima: %3$lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načteno ze serveru: %1$lld (stránek: %2$lld). Odpovídá vašim kritériím: %3$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentet fra server: %1$lld (sider: %2$lld). Matcher dine kriterier: %3$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgehaald van server: %1$lld (pagina's: %2$lld). Komt overeen met je criteria: %3$lld."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverist toodud: %1$lld (lehti: %2$lld). Vastab teie kriteeriumidele: %3$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haettu palvelimelta: %1$lld (sivuja: %2$lld). Vastaa ehtojasi: %3$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérés depuis le serveur : %1$lld (pages : %2$lld). Correspondant à vos critères : %3$lld."
          }
        }
      }
    },
