    "No photos were found in both locations.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen foto's is op albei plekke gevind nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على صور في كلا الموقعين."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez da argazkirik aurkitu bi kokalekuetan."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Фота не знойдзена ў абодвух месцах."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не са намерени снимки и на двете места."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha trobat cap foto a les dues ubicacions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两个位置都未找到照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在兩個位置都找不到照片。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna fotografija nije pronađena na obje lokacije."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V obou umístěních nebyly nalezeny žádné fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet fotos begge steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen foto's op beide locaties gevonden."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotosid ei leitud mõlemas asukohas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvia ei löytynyt molemmista sijainneista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune photo trouvée aux deux emplacements."
          }
        }
      }
    },
