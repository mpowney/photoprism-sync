    "Configure PhotoPrism credentials to compare delete candidates against remote duplicates." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel PhotoPrism-magtigingsbewyse op om uitveeskandidate met afstandduplikate te vergelyk."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإعداد بيانات اعتماد PhotoPrism لمقارنة المرشحين للحذف بالتكرارات البعيدة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наладзьце ўліковыя даныя PhotoPrism, каб параўнаць кандыдатаў на выдаленне з аддаленымі дублікатамі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфигурирайте данните за вход в PhotoPrism, за да сравните кандидатите за изтриване с отдалечените дубликати."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura les credencials de PhotoPrism per comparar els candidats a eliminar amb els duplicats remots."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte přihlašovací údaje PhotoPrism, abyste mohli porovnat kandidáty na smazání se vzdálenými duplicitami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurer PhotoPrism-legitimationsoplysninger for at sammenligne sletningskandidater med eksterne dubletter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure PhotoPrism credentials to compare delete candidates against remote duplicates."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadistage PhotoPrismi volitused, et võrrelda kustutatavaid kandidaate kaugduplikaatidega."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguratu PhotoPrism kredentzialak ezabatzeko hautagaiak urruneko bikoizketekin alderatzeko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määritä PhotoPrismin tunnistetiedot, jotta poistoehdokkaat voidaan verrata etäkaksoiskappaleisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez les identifiants PhotoPrism pour comparer les candidats à la suppression avec les doublons distants."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurirajte PhotoPrism vjerodajnice kako biste usporedili kandidate za brisanje s udaljenim duplikatima."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel PhotoPrism-inloggegevens in om kandidaten voor verwijdering te vergelijken met externe duplicaten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请配置 PhotoPrism 凭据，以便将待删除项目与远程重复项进行比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
