    "The PhotoPrism server URL and username are stored in app preferences, and the password is stored in the device keychain. Uploads use original asset data so PhotoPrism receives the best available metadata.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PhotoPrism server URL and username are stored in app preferences, and the password is stored in the device keychain. Uploads use original asset data so PhotoPrism receives the best available metadata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PhotoPrism-bediener-URL en gebruikersnaam word in programvoorkeure gestoor, en die wagwoord word in die toestel se sleutelhanger gestoor. Oplaaie gebruik oorspronklike bate-data sodat PhotoPrism die beste beskikbare metadata ontvang."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين عنوان URL لخادم PhotoPrism واسم المستخدم في تفضيلات التطبيق، بينما تُخزَّن كلمة المرور في سلسلة مفاتيح الجهاز. تستخدم عمليات الرفع بيانات الأصول الأصلية حتى يتلقى PhotoPrism أفضل البيانات الوصفية المتاحة."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism zerbitzariaren URLa eta erabiltzaile-izena aplikazioaren hobespenetan gordetzen dira, eta pasahitza gailuaren gako-sortan. Igoerek jatorrizko aktiboen datuak erabiltzen dituzte, PhotoPrismek eskuragarri dagoen metadatu onena jaso dezan."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "URL сервера PhotoPrism і імя карыстальніка захоўваюцца ў наладах праграмы, а пароль — у звязцы ключоў прылады. Пры запампоўцы выкарыстоўваюцца зыходныя даныя актываў, каб PhotoPrism атрымаў лепшыя даступныя метаданыя."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "URL адресът на сървъра на PhotoPrism и потребителското име се съхраняват в предпочитанията на приложението, а паролата — във връзката с ключове на устройството. Качванията използват оригиналните данни на файловете, за да получи PhotoPrism най-добрите налични метаданни."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL del servidor de PhotoPrism i el nom d'usuari es desen a les preferències de l'app, i la contrasenya es desa al clauer del dispositiu. Les pujades utilitzen les dades originals dels fitxers perquè PhotoPrism rebi les millors metadades disponibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism 服务器 URL 和用户名存储在 App 偏好设置中，密码存储在设备钥匙串中。上传使用原始资源数据，以便 PhotoPrism 获得最佳的可用元数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism 伺服器 URL 和使用者名稱儲存在 App 偏好設定中，密碼則儲存在裝置鑰匙圈中。上傳會使用原始資源資料，讓 PhotoPrism 取得最佳的可用中繼資料。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL PhotoPrism poslužitelja i korisničko ime spremaju se u postavke aplikacije, a zaporka u privjesak ključeva uređaja. Prijenosi koriste izvorne podatke datoteka kako bi PhotoPrism primio najbolje dostupne metapodatke."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa URL serveru PhotoPrism a uživatelské jméno jsou uloženy v předvolbách aplikace a heslo je uloženo v klíčence zařízení. Nahrávání používá původní data médií, aby PhotoPrism obdržel nejlepší dostupná metadata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism-serverens URL og brugernavn gemmes i appens indstillinger, og adgangskoden gemmes i enhedens nøglering. Uploads bruger de originale mediedata, så PhotoPrism modtager de bedste tilgængelige metadata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PhotoPrism-server-URL en gebruikersnaam worden opgeslagen in de appvoorkeuren en het wachtwoord wordt opgeslagen in de sleutelhanger van het apparaat. Uploads gebruiken de originele assetgegevens, zodat PhotoPrism de best beschikbare metagegevens ontvangt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrismi serveri URL ja kasutajanimi salvestatakse rakenduse eelistustesse ning parool seadme võtmehoidjasse. Üleslaadimisel kasutatakse algseid failiandmeid, et PhotoPrism saaks parimad saadaolevad metaandmed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism-palvelimen URL-osoite ja käyttäjänimi tallennetaan sovelluksen asetuksiin, ja salasana tallennetaan laitteen avainnippuun. Lähetykset käyttävät alkuperäisiä tiedostotietoja, jotta PhotoPrism saa parhaat saatavilla olevat metatiedot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL du serveur PhotoPrism et le nom d'utilisateur sont enregistrés dans les préférences de l'app, et le mot de passe dans le trousseau de l'appareil. Les téléversements utilisent les données d'origine des fichiers afin que PhotoPrism reçoive les meilleures métadonnées disponibles."
          }
        }
      }
    },
    "The PhotoPrism server returned an invalid response.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PhotoPrism server returned an invalid response."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PhotoPrism-bediener het 'n ongeldige antwoord gestuur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد خادم PhotoPrism استجابة غير صالحة."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism zerbitzariak erantzun baliogabea itzuli du."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер PhotoPrism вярнуў несапраўдны адказ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сървърът на PhotoPrism върна невалиден отговор."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de PhotoPrism ha retornat una resposta no vàlida."
          }
