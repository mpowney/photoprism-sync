        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoPrism-palvelin palautti virheellisen vastauksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur PhotoPrism a renvoyé une réponse non valide."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoPrism poslužitelj vratio je nevaljan odgovor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De PhotoPrism-server gaf een ongeldig antwoord."
          }
        },
        "zh-Hans" : {
