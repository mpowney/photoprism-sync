            "value": "Nijedna fotografija nije pronađena na obje lokacije."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V obou umístěních nebyly nalezeny žádné fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet fotos begge steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen foto's op beide locaties gevonden."
          }
        },
        "et": {
