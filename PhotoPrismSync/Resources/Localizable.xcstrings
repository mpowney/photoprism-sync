    "A PhotoPrism photo did not include a download URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PhotoPrism photo did not include a download URL."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n PhotoPrism-foto het nie 'n aflaai-URL ingesluit nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتضمن صورة في PhotoPrism عنوان URL للتنزيل."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrismeko argazki batek ez zuen deskarga-URLrik."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Фота ў PhotoPrism не ўтрымлівала URL для спампоўкі."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимка в PhotoPrism не съдържаше URL адрес за изтегляне."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una foto de PhotoPrism no incloïa cap URL de baixada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某张 PhotoPrism 照片不包含下载 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某張 PhotoPrism 照片不包含下載 URL。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija u PhotoPrismu nije sadržavala URL za preuzimanje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka v PhotoPrism neobsahovala adresu URL ke stažení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et PhotoPrism-foto indeholdt ikke en download-URL."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een PhotoPrism-foto bevatte geen download-URL."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrismi foto ei sisaldanud allalaadimise URL-i."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrismin kuva ei sisältänyt latauksen URL-osoitetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo PhotoPrism ne contenait pas d'URL de téléchargement."
          }
        }
      }
    },
    "A selected photo could not be loaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected photo could not be loaded."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Gekose foto kon nie gelaai word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل صورة محددة."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hautatutako argazki bat ezin izan da kargatu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося загрузіць выбранае фота."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избрана снимка не може да бъде заредена."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut carregar una foto seleccionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载所选照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入所選照片。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabranu fotografiju nije moguće učitati."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybranou fotku se nepodařilo načíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et valgt foto kunne ikke indlæses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een geselecteerde foto kon niet worden geladen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitud fotot ei saanud laadida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittua kuvaa ei voitu ladata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo sélectionnée n'a pas pu être chargée."
          }
        }
      }
    },
    "A temporary upload file could not be created.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary upload file could not be created."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Tydelike oplaailêer kon nie geskep word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إنشاء ملف رفع مؤقت."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin izan da aldi baterako igoera-fitxategia sortu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося стварыць часовы файл для запампоўкі."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не може да се създаде временен файл за качване."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut crear un fitxer de pujada temporal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建临时上传文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立暫時上傳檔案。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privremena datoteka za prijenos nije mogla biti stvorena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se vytvořit dočasný soubor pro nahrání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En midlertidig uploadfil kunne ikke oprettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kon geen tijdelijk uploadbestand worden gemaakt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajutist üleslaadimisfaili ei saanud luua."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väliaikaista lähetystiedostoa ei voitu luoda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier de téléversement temporaire n'a pas pu être créé."
          }
        }
      }
