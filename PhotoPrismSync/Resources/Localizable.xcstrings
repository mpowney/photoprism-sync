    "When enabled, duplicate checks compare your local library against PhotoPrism and require server credentials.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, duplicate checks compare your local library against PhotoPrism and require server credentials."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer geaktiveer, vergelyk duplikaatkontroles jou plaaslike biblioteek met PhotoPrism en vereis bedienermagtigings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، تقارن عمليات التحقق من التكرارات مكتبتك المحلية مع PhotoPrism وتتطلب بيانات اعتماد الخادم."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaituta dagoenean, bikoizketen egiaztapenek zure tokiko liburutegia PhotoPrismekin alderatzen dute eta zerbitzariaren kredentzialak behar dituzte."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі ўключана, праверка дублікатаў параўноўвае вашу лакальную бібліятэку з PhotoPrism і патрабуе ўліковыя даныя сервера."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато е включено, проверките за дубликати сравняват локалната ви библиотека с PhotoPrism и изискват данни за вход в сървъра."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si està activat, la comprovació de duplicats compara la teva biblioteca local amb PhotoPrism i requereix credencials del servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，重复项检查会将您的本地图库与 PhotoPrism 进行比较，并需要服务器凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，重複項目檢查會將您的本機資料庫與 PhotoPrism 比對，並需要伺服器憑證。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada je uključeno, provjere duplikata uspoređuju vašu lokalnu biblioteku s PhotoPrismom i zahtijevaju vjerodajnice poslužitelja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je zapnuto, kontrola duplicit porovnává vaši místní knihovnu s PhotoPrism a vyžaduje přihlašovací údaje k serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er aktiveret, sammenligner dubletkontrol dit lokale bibliotek med PhotoPrism og kræver serverlegitimationsoplysninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld, vergelijkt de duplicatencontrole je lokale bibliotheek met PhotoPrism en zijn serverinloggegevens vereist."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see on lubatud, võrdleb duplikaatide kontroll teie kohalikku kogu PhotoPrismiga ja nõuab serveri volitusi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun käytössä, kaksoiskappaleiden tarkistus vertaa paikallista kirjastoasi PhotoPrismiin ja vaatii palvelimen tunnistetiedot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, la détection des doublons compare votre bibliothèque locale à PhotoPrism et nécessite les identifiants du serveur."
          }
        }
      }
    },
