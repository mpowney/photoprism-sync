          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намерени и на двете места"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincideix a les dues ubicacions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两处均匹配"
          }
        },
        "zh-Hant": {
