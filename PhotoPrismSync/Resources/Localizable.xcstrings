          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عناصر تطابق هذه المرشحات. اضبط معاييرك واحسب مرة أخرى."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementurik ez dator iragazki hauekin bat. Doitu zure irizpideak eta kalkulatu berriro."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводны элемент не адпавядае гэтым фільтрам. Змяніце крытэрыі і разлічыце зноў."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма елементи, отговарящи на тези филтри. Променете критериите и изчислете отново."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap element coincideix amb aquests filtres. Ajusta els criteris i torna a calcular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有符合这些筛选条件的项目。请调整条件后重新计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合這些篩選條件的項目。請調整條件後重新計算。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna stavka ne odgovara ovim filtrima. Prilagodite kriterije i ponovno izračunajte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Těmto filtrům neodpovídají žádné položky. Upravte kritéria a vypočtěte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen emner matcher disse filtre. Juster dine kriterier, og beregn igen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen items komen overeen met deze filters. Pas je criteria aan en bereken opnieuw."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükski üksus ei vasta nendele filtritele. Muutke kriteeriume ja arvutage uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään kohde ei vastaa näitä suodattimia. Muokkaa ehtoja ja laske uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément ne correspond à ces filtres. Ajustez vos critères et recalculez."
          }
        }
      }
    },
    "No matching items found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching items found."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen passende items gevind nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على عناصر مطابقة."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez da bat datorren elementurik aurkitu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адпаведных элементаў не знойдзена."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не са намерени съвпадащи елементи."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha trobat cap element coincident."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到匹配项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到相符項目。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisu pronađene podudarne stavke."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyly nalezeny žádné odpovídající položky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen matchende emner fundet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen overeenkomende items gevonden."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobivaid üksusi ei leitud."
          }
        },
        "fi": {
