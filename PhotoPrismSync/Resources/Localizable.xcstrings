    "This removes the selected photos from your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the selected photos from your device."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwyder die gekose foto's van jou toestel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة الصور المحددة من جهازك."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Honek hautatutako argazkiak zure gailutik kentzen ditu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта выдаліць выбраныя фота з вашай прылады."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще премахне избраните снимки от устройството ви."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina les fotos seleccionades del dispositiu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从您的设备中移除所选照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從您的裝置移除所選照片。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovime se odabrane fotografije uklanjaju s vašeg uređaja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se vybrané fotky odeberou z vašeho zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner de valgte fotos fra din enhed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de geselecteerde foto's van je apparaat verwijderd."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See eemaldab valitud fotod teie seadmest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa valitut kuvat laitteeltasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les photos sélectionnées de votre appareil."
          }
        }
      }
    },
