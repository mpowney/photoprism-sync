            "state": "translated",
            "value": "Vastaavia kohteita ei löytynyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément correspondant trouvé."
          }
        }
      }
    },
    "No photos were found in both locations.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen foto's is op albei plekke gevind nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على صور في كلا الموقعين."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez da argazkirik aurkitu bi kokalekuetan."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Фота не знойдзена ў абодвух месцах."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
