    "Your matching photos and videos will appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your matching photos and videos will appear here."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou passende foto's en video's sal hier verskyn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر صورك ومقاطع الفيديو المطابقة هنا."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bat datozen argazkiak eta bideoak hemen agertuko dira."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адпаведныя фота і відэа з’явяцца тут."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съвпадащите ви снимки и видеа ще се покажат тук."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos i els vídeos coincidents apareixeran aquí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配的照片和视频将显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相符的照片和影片會顯示在這裡。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje će se pojaviti vaše podudarne fotografije i videozapisi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí odpovídající fotky a videa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine matchende fotos og videoer vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je overeenkomende foto's en video's verschijnen hier."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie sobivad fotod ja videod ilmuvad siin."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaavat kuvasi ja videosi näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos et vidéos correspondantes s'afficheront ici."
          }
        }
      }
    }
  },
  "version": "1.0"
}
