            "value": "PhotoPrism 服务器返回了无效响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism 伺服器傳回了無效的回應。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism poslužitelj vratio je nevaljan odgovor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server PhotoPrism vrátil neplatnou odpověď."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrism-serveren returnerede et ugyldigt svar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PhotoPrism-server gaf een ongeldig antwoord."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoPrismi server tagastas kehtetu vastuse."
          }
        },
        "fi": {
