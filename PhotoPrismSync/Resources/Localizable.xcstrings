    "Add your server URL and credentials in Settings. Photos access is requested when you calculate a local selection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your server URL and credentials in Settings. Photos access is requested when you calculate a local selection."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg jou bediener-URL en magtigingsbewyse by Instellings by. Toegang tot Foto's word gevra wanneer jy 'n plaaslike keuse bereken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عنوان URL للخادم وبيانات الاعتماد في الإعدادات. يتم طلب الوصول إلى الصور عند حساب تحديد محلي."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehitu zure zerbitzariaren URLa eta kredentzialak Ezarpenetan. Argazkietarako sarbidea eskatuko da tokiko hautaketa bat kalkulatzean."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадайце URL сервера і ўліковыя даныя ў Наладах. Доступ да Фота запытваецца, калі вы разлічваеце лакальны выбар."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете URL адреса на сървъра и данните за вход в Настройки. Достъп до Снимки се изисква при изчисляване на локален избор."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix l'URL del servidor i les credencials als Ajustos. L'accés a Fotos es demana quan calcules una selecció local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中添加服务器 URL 和凭据。计算本地选择时会请求访问“照片”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中加入伺服器 URL 和憑證。計算本機選取內容時會要求存取「照片」。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte URL poslužitelja i vjerodajnice u Postavkama. Pristup fotografijama traži se kada izračunate lokalni odabir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte v Nastavení adresu URL serveru a přihlašovací údaje. Přístup k Fotkám se vyžaduje při výpočtu místního výběru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj din server-URL og dine legitimationsoplysninger i Indstillinger. Adgang til Fotos anmodes, når du beregner et lokalt udvalg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de server-URL en inloggegevens toe in Instellingen. Toegang tot Foto's wordt gevraagd wanneer je een lokale selectie berekent."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisage serveri URL ja volitused jaotises Seaded. Juurdepääsu fotodele küsitakse kohaliku valiku arvutamisel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää palvelimen URL-osoite ja tunnistetiedot Asetuksissa. Kuvien käyttöoikeutta pyydetään, kun lasket paikallisen valinnan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l'URL du serveur et vos identifiants dans les Réglages. L'accès à Photos est demandé lorsque vous calculez une sélection locale."
          }
        }
      }
    },
